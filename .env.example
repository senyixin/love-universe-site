PORT=5173
HOST=0.0.0.0
ADMIN_EMAIL_TO=your@qq.com
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=qq-mail-smtp-authorization-code
SMTP_FROM=your@qq.com
AMAP_WEATHER_KEY=your-amap-web-service-key
GETUI_APP_ID=your-getui-app-id
GETUI_APP_KEY=your-getui-app-key
GETUI_APP_SECRET=your-getui-app-secret
GETUI_MASTER_SECRET=your-getui-master-secret
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
